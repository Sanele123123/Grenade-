# Copy to .env (or set these in your host's dashboard). Never commit real values.

# --- Required for any public deployment ---
# The engine refuses to start on a non-local HOST without an admin token.
BBP_ADMIN_TOKEN=change-me-to-a-long-random-string
BBP_ENCRYPTION_KEY=change-me-to-another-long-random-string

# --- Server ---
HOST=0.0.0.0
PORT=4173
# Where settings/jobs/generated sites are stored (default: ./data). Point at a persistent disk if you have one.
# BBP_DATA_DIR=/var/data

# --- Public demo (recommended for showing clients) ---
# Builds template-based sample sites with no AI keys or outbound calls.
# Anonymous visitors can only use the intake/build/review/approve flow.
BBP_DEMO_MODE=true
# BBP_DEMO_JOBS_PER_HOUR=6
# BBP_DEMO_MAX_JOBS=40

# --- Real builds (leave off for the public demo) ---
# BBP_ENABLE_REAL_OUTBOUND=true
# BBP_CALLBACK_URL=https://your-domain.example/api/callback
